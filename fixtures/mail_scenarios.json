{
  "schema_version": 1,
  "notice": "全て架空。テスト専用であり実メール送信用ではない。承認済み規則という条件も架空試験だけの設定。",
  "scenarios": [
    {
      "id": "F01",
      "synthetic": true,
      "received_at": "2026-09-17T09:00:00+09:00",
      "sender": "requester@example.invalid",
      "recipient": "user@example.invalid",
      "subject": "回答人数の報告（依頼）",
      "body": "【定型試験】提出期限：2026年9月22日17:00。回答人数を報告してください。",
      "readable": true,
      "expected": {
        "intake": "linked_task",
        "deadline_kind": "datetime",
        "confirmed_deadline": "2026-09-22T17:00:00+09:00",
        "reason": "この架空定型規則が事前承認済みという試験条件のみ。"
      },
      "approved_fixture_rule": "fixture-count-report-v1"
    },
    {
      "id": "F02",
      "synthetic": true,
      "received_at": "2026-09-17T09:00:00+09:00",
      "sender": "requester@example.invalid",
      "recipient": "user@example.invalid",
      "subject": "こちらもお願いします",
      "body": "先日の資料の件、こちらでお願いします。",
      "readable": true,
      "expected": {
        "intake": "needs_review",
        "deadline_kind": "unknown",
        "must_not": "業務内容と期限を補完しない"
      }
    },
    {
      "id": "F03",
      "synthetic": true,
      "received_at": "2026-09-17T09:00:00+09:00",
